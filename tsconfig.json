{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ESNext", "DOM"]
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules", "*.test.*"]
}
